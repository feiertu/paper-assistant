# ===== Paper Assistant 环境变量示例 =====
# 复制为 .env 并填入实际值，.env 已在 .gitignore 中

# ---------- LLM ----------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1    # 如果用 Qwen 等国产模型，填对应 URL
# LLM_MODEL=qwen-2.5-72b-instruct
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# ---------- Embedding ----------
# EMBEDDING_PROVIDER=openai,voyage              # 逗号分隔，可选 openai / voyage。双路开启 RRF 重排序
# EMBEDDING_MODEL=text-embedding-3-large        # OpenAI embedding 模型名
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=32
# RRF_TOP_N=20                                  # RRF 融合时每路取 top-N
# RRF_K=60                                      # RRF 平滑常数

# ---------- Voyage AI ----------
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 检索 ----------
# RAG_TOP_K=5
# RAG_COLLECTION_NAME=knowledge

# ---------- arXiv ----------
# ARXIV_QUERY=cat:cs.AI AND ti:learning
# ARXIV_MAX_RESULTS=5
# PDF_DOWNLOAD_DELAY=3.0

# ---------- 路径（一般不用改） ----------
# PAPER_ASSISTANT_DATA_DIR=D:/git/paper-assistant/data
# PAPER_ASSISTANT_CHROMA_DIR=D:/git/paper-assistant/data/chroma_db

# ---------- API / UI ----------
# API_HOST=127.0.0.1
# API_PORT=8000

# ---------- 日志 ----------
# PAPER_ASSISTANT_LOG_LEVEL=INFO               # DEBUG / INFO / WARNING / ERROR

# ---------- 缓存 ----------
# CACHE_ENABLED=true
# CACHE_LLM_TTL=1800                           # LLM 缓存 30 分钟
# CACHE_EMBED_TTL=86400                        # Embedding 缓存 24 小时

# ---------- 任务级模型（独立配置，不设置则用 LLM_MODEL） ----------
# LLM_QA_MODEL=qwen-2.5-72b-instruct
# LLM_SUMMARY_MODEL=gpt-4o-mini
# LLM_SURVEY_MODEL=deepseek-v3

# ---------- API 鉴权 / 限流 ----------
# API_AUTH_ENABLED=false
# API_AUTH_KEY=your-secret-api-key
# API_RATE_LIMIT=30/minute
