# ===== Paper Assistant 环境变量示例 =====
# 复制为 .env 并填入实际值，.env 已在 .gitignore 中

# ---------- LLM ----------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1    # 如果用 Qwen 等国产模型，填对应 URL
# LLM_MODEL=qwen-2.5-72b-instruct
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# ---------- Embedding ----------
# EMBEDDING_PROVIDER=openai,voyage              # 逗号分隔，可选 openai / voyage。双路开启 RRF 重排序
# EMBEDDING_MODEL=text-embedding-3-large        # OpenAI embedding 模型名
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=32
# RRF_TOP_N=20                                  # RRF 融合时每路取 top-N
# RRF_K=60                                      # RRF 平滑常数

# ---------- Voyage AI ----------
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 检索 ----------
# RAG_TOP_K=5
# RAG_COLLECTION_NAME=knowledge

# ---------- arXiv ----------
# ARXIV_QUERY=cat:cs.AI AND ti:learning
# ARXIV_MAX_RESULTS=5
# PDF_DOWNLOAD_DELAY=3.0

# ---------- 路径（一般不用改） ----------
# PAPER_ASSISTANT_DATA_DIR=D:/git/paper-assistant/data
# PAPER_ASSISTANT_CHROMA_DIR=D:/git/paper-assistant/data/chroma_db

# ---------- API / UI ----------
# API_HOST=127.0.0.1
# API_PORT=8000

# ---------- 日志 ----------
# PAPER_ASSISTANT_LOG_LEVEL=INFO               # DEBUG / INFO / WARNING / ERROR

# ---------- PDF 解析 ----------
# PDF_PARSER=pymupdf                              # 解析后端: pymupdf(默认) | docling(Markdown/推荐) | grobid(Docker)
# PAPER_ASSISTANT_GROBID_URL=http://localhost:8070  # GROBID 服务地址
# PDF_MIN_BODY_SIZE=6.5                           # pymupdf 模式正文字号阈值

# ---------- 混合检索 v3（稠密 + BM25 + Cross-Encoder 精排）----------
# HYBRID_RETRIEVAL=true                           # 启用混合检索
# BM25_ENABLED=true                               # BM25 稀疏检索（关键词精确匹配）
# RERANKER_ENABLED=true                           # Cross-Encoder 重排序
# BM25_WEIGHT=0.3                                 # BM25 在 RRF 融合中的权重 (0-1)

# ---------- 缓存 ----------
# CACHE_ENABLED=true
# CACHE_LLM_TTL=1800                           # LLM 缓存 30 分钟
# CACHE_EMBED_TTL=86400                        # Embedding 缓存 24 小时

# ---------- 任务级模型（独立配置，不设置则用 LLM_MODEL） ----------
# LLM_QA_MODEL=qwen-2.5-72b-instruct
# LLM_SUMMARY_MODEL=gpt-4o-mini
# LLM_SURVEY_MODEL=deepseek-v3

# ---------- Agent ----------
# LLM_AGENT_MODEL=gpt-4o                       # Agent 专用模型（需支持 function calling）
# AGENT_MAX_ITERATIONS=10                      # Agent 最大推理步数
# AGENT_TEMPERATURE=0.1                        # Agent 温度（建议低值确保工具调用稳定）
# AGENT_MAX_CONTEXT_TOKENS=8000                # 上下文窗口上限
# AGENT_TOOL_RETRY=2                           # 工具调用失败重试次数

# ---------- API 鉴权 / 限流 ----------
# API_AUTH_ENABLED=false
# API_AUTH_KEY=your-secret-api-key
# API_RATE_LIMIT=30/minute
# API_CORS_ORIGINS=https://your-domain.com    # 生产环境必须设置，逗号分隔多个域名
